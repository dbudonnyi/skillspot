# PostgreSQL connection
DATABASE_URL="postgresql://skillspot:***@127.0.0.1:5432/skillspot"

# Session signing secret (any long random string)
JWT_SECRET="change…ring"

# Base URL used in emails and redirects
NEXT_PUBLIC_APP_URL="http://localhost:8080"

# SMTP (optional — without these, emails go to Ethereal + console log)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="SkillSpot <noreply@example.com>"
